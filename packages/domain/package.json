{
  "name": "@tmanage/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure value objects, authorization policies, and state machines. No I/O, no framework, no ORM.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./realtime-ticket": {
      "types": "./dist/realtime/ticket.d.ts",
      "default": "./dist/realtime/ticket.js"
    },
    "./field-cipher": {
      "types": "./dist/security/field-cipher.d.ts",
      "default": "./dist/security/field-cipher.js"
    },
    "./zatca-sign": {
      "types": "./dist/finance/zatca/sign.d.ts",
      "default": "./dist/finance/zatca/sign.js"
    },
    "./contact-addresses": {
      "types": "./dist/contact/contact-addresses.d.ts",
      "default": "./dist/contact/contact-addresses.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
