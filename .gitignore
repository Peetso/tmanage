node_modules/
dist/
build/
coverage/
.next/
# Regenerated by `next build`, and it references files inside .next/ that a clean
# clone does not have. Committing it would make `pnpm typecheck` fail before the
# first build. See apps/web/tsconfig.json, which does not include it.
next-env.d.ts
out/
*.tsbuildinfo
.turbo/

# Environment — only .env.example is committed. Never commit a real .env.
.env
.env.*
!.env.example

# Local development substitutes (see ADR-0002)
.local/
storage-local/
pgdata/

# Relay runtime state — `.env.example` points OUTBOX_HEARTBEAT_FILE here, and a heartbeat is
# a fact about one running process, never something to commit.
var/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test + tooling output
playwright-report/
test-results/
storybook-static/
*.log

# Playwright (TEST-003)
e2e/test-results/
e2e/playwright-report/

# Knowledge graph built locally by graphify (AST-only); rebuilt with `graphify update .`
graphify-out/
