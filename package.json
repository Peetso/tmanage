{
  "name": "tmanage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TManage \u2014 multi-tenant Work Operating System for service teams and their clients",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.15.0"
  },
  "scripts": {
    "audit:design": "node scripts/audit-design-source.mjs",
    "arch:parts": "node scripts/arch/part-docs-check.mjs",
    "test:arch": "node --test scripts/arch/part-docs.test.mjs",
    "audit:prod": "pnpm audit --prod --audit-level low",
    "build": "pnpm build:packages && pnpm -r --filter=./apps/** build",
    "build:packages": "pnpm -r --filter=./packages/** build && pnpm --filter @tmanage/mcp-server build",
    "build:worker": "pnpm --filter @tmanage/worker build",
    "typecheck": "pnpm build:packages && pnpm build:worker && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && pnpm -r test",
    "test:unit": "pnpm build:packages && pnpm -r test:unit",
    "test:db": "pnpm build:packages && pnpm build:worker && pnpm --filter @tmanage/api test:db",
    "db:migrate": "pnpm --filter @tmanage/api db:migrate",
    "db:status": "pnpm --filter @tmanage/api db:status",
    "db:grants": "pnpm --filter @tmanage/api db:grants",
    "db:reset": "pnpm --filter @tmanage/api db:reset",
    "contracts:check": "node scripts/contracts-check.mjs",
    "check:mariadb": "node scripts/check-mariadb-compat.mjs",
    "security:sbom": "node scripts/security/sbom.mjs",
    "security:licenses": "node scripts/security/license-check.mjs",
    "security:supply-chain": "node scripts/security/lockfile-policy.mjs --audit",
    "test:supply-chain": "node --test scripts/security/supply-chain.test.mjs",
    "lint:copy": "node scripts/i18n/copy-lint.mjs",
    "test:copy": "vitest run scripts/i18n/copy-lint.test.mjs",
    "lint:csv": "node scripts/lint/csv-exports.mjs",
    "test:csv-lint": "node --test scripts/lint/csv-exports.test.mjs",
    "dev": "pnpm --parallel --filter @tmanage/api --filter @tmanage/web --filter @tmanage/worker dev",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm contracts:check && pnpm check:mariadb && pnpm security:supply-chain && pnpm security:licenses && pnpm lint:copy && pnpm lint:csv && pnpm audit:design && pnpm test && pnpm verify:gaps",
    "verify:gaps": "node scripts/verify-gaps.mjs",
    "verify:full": "pnpm verify && pnpm test:db && pnpm test:e2e && pnpm test:vr",
    "test:e2e": "pnpm --filter @tmanage/e2e test:e2e",
    "test:vr": "pnpm --filter @tmanage/ui test:vr",
    "test:vr:update": "pnpm --filter @tmanage/ui test:vr:update",
    "deploy:hostinger": "node deploy/hostinger/build.mjs",
    "deploy:hostinger:branch": "node deploy/hostinger/branch.mjs",
    "deploy:hostinger:smoke": "node deploy/hostinger/smoke.mjs",
    "deploy:self-host": "node deploy/self-host/pack.mjs",
    "deploy:self-host:env": "pnpm --filter @tmanage/config build && node deploy/self-host/env-reference.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@node-rs/argon2": "^2.1.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mysql2": "^3.15.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": "^0.6.1",
      "body-parser@>=2 <2.4.0": "2.4.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "fast-uri@<3.1.9": "^3.1.9",
      "fast-uri@>=4 <4.2.3": "^4.2.3",
      "fastify": "5.12.7",
      "@fastify/middie@<9.3.7": "^9.3.7",
      "express-rate-limit@<8.7.5": "^8.7.5",
      "hono@<4.13.16": "^4.13.16",
      "@hono/node-server@>=2 <2.1.11": "^2.1.11",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "sharp": ">=0.35.5 <0.36",
      "source-map-js": "^1.2.2",
      "tar": "^7.5.21",
      "zod": "^4.6.7"
    }
  }
}
