{
  "name": "tmanage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TManage \u2014 multi-tenant Work Operating System for service teams and their clients",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.15.0"
  },
  "scripts": {
    "audit:design": "node scripts/audit-design-source.mjs",
    "build": "pnpm build:packages && pnpm -r --filter=./apps/** build",
    "build:packages": "pnpm -r --filter=./packages/** build",
    "build:worker": "pnpm --filter @tmanage/worker build",
    "typecheck": "pnpm build:packages && pnpm build:worker && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && pnpm -r test",
    "test:unit": "pnpm build:packages && pnpm -r test:unit",
    "test:db": "pnpm build:packages && pnpm build:worker && pnpm --filter @tmanage/api test:db",
    "db:migrate": "pnpm --filter @tmanage/api db:migrate",
    "db:status": "pnpm --filter @tmanage/api db:status",
    "db:grants": "pnpm --filter @tmanage/api db:grants",
    "db:reset": "pnpm --filter @tmanage/api db:reset",
    "db:seed": "pnpm --filter @tmanage/api db:seed",
    "contracts:check": "node scripts/contracts-check.mjs",
    "check:mariadb": "node scripts/check-mariadb-compat.mjs",
    "dev": "pnpm --parallel --filter @tmanage/api --filter @tmanage/web --filter @tmanage/worker dev",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm contracts:check && pnpm check:mariadb && pnpm audit:design && pnpm test && pnpm verify:gaps",
    "verify:gaps": "node scripts/verify-gaps.mjs",
    "verify:full": "pnpm verify && pnpm test:db && pnpm test:e2e && pnpm test:vr",
    "test:e2e": "pnpm --filter @tmanage/e2e test:e2e",
    "test:vr": "pnpm --filter @tmanage/ui test:vr",
    "test:vr:update": "pnpm --filter @tmanage/ui test:vr:update",
    "deploy:hostinger": "node deploy/hostinger/build.mjs",
    "deploy:hostinger:branch": "node deploy/hostinger/branch.mjs",
    "deploy:hostinger:smoke": "node deploy/hostinger/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@node-rs/argon2": "^2.1.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mysql2": "^3.15.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": "^0.6.1",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "fast-uri@<3.1.8": "^3.1.8",
      "fast-uri@>=4 <4.1.5": "^4.1.5",
      "fastify": "5.12.7",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "sharp": ">=0.35.5 <0.36",
      "source-map-js": "^1.2.2",
      "tar": "^7.5.21"
    }
  }
}
