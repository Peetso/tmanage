# TManage — Hostinger (shared hosting, Node.js app) environment template.
#
# Copy the NAME = VALUE pairs below into hPanel's Node.js app "Environment variables" screen.
# This file ships NO real secrets. Generate every secret yourself with:
#     node generate-secret.mjs            (a 32-byte secret)
#     node generate-secret.mjs --mfa      (an AUTH_MFA_SEED_KEYS line)
# and keep the real values only in the hPanel screen — never in a file in the repo.
#
# Lines beginning with "#" are explanations, not variables. "look for" means the exact label
# in hPanel may differ slightly from the words here; find the nearest match.

# ── The basics ────────────────────────────────────────────────────────────────
# Tells the app it is running for real. Must be exactly this word. (If it is missing the app
# uses production anyway; any other word stops the app from starting, on purpose.)
NODE_ENV=production

# PORT is set BY Hostinger automatically — it tells the app which port to listen on. Do NOT
# set it yourself unless the panel asks you to; the app reads whatever Hostinger provides.
# PORT=

# The public https address of the site, both halves. Same value for both — the web app and the
# API are served from this one origin. Use your real subdomain.
API_PUBLIC_URL=https://tmanage.peetrix.com
WEB_PUBLIC_URL=https://tmanage.peetrix.com

# Who may call the API from a browser. Same origin as above. Comma-separated if ever more than one.
CORS_ALLOWED_ORIGINS=https://tmanage.peetrix.com

# There are NO NEXT_PUBLIC_* settings to add. Those are fixed inside the bundle when the team
# builds it (the pages call the API on this same address), so changing a setting here only
# restarts the app — it never needs a rebuild.

# The one proxy in front of the app is Hostinger's own, which forwards from the local machine.
# Trusting that single hop lets the app see each visitor's real address (used for rate limits).
# If sign-in rate limits behave as if everyone shares one address, this is the value to revisit.
TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1

# ── Database — SET AUTOMATICALLY by Hostinger ─────────────────────────────────
# When you create the database in the Web app's setup, Hostinger writes these variables itself
# and you never see the password: DATABASE_URL (mysql://user:password@host:port/name) and
# DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD. Do NOT type them; leave them as Hostinger set
# them. The app uses DATABASE_URL, or builds it from the DB_* values if only those exist.
#
# Hostinger gives the database ONE user. The app then runs its everyday work, its schema changes
# (migrations) and its background jobs with that one user, and says "single-user mode" in the log.
# A host of "localhost" is changed to 127.0.0.1 automatically (on Hostinger "localhost" can mean
# the IPv6 address, which the database user is not allowed to use).
#
# Only if you ever create the database by hand instead, set this one line yourself:
# DATABASE_URL=mysql://<user>:<password>@127.0.0.1:3306/<database_name>
# (letters and digits only in the password, or percent-encode any symbols).
#
# Optional, for a host that allows separate users (not Hostinger shared): give the migrations and
# the worker their own users and the app keeps them apart.
# DATABASE_MIGRATION_URL=mysql://<migrator_user>:<password>@127.0.0.1:3306/<database_name>
# WORKER_DATABASE_URL=mysql://<worker_user>:<password>@127.0.0.1:3306/<database_name>

# Keep the pool small — shared MySQL allows few connections at once.
DATABASE_POOL_MAX=5

# ── Secrets (generate each one; all must differ from each other) ────────────────
# Session signing, CSRF signing, and the keyring that encrypts second-factor seeds.
# Run `node generate-secret.mjs` for the first two and `node generate-secret.mjs --mfa` for the
# third. Never reuse a value between them.
SESSION_SECRET=<32+ character secret from generate-secret.mjs>
CSRF_SECRET=<a DIFFERENT 32+ character secret>
AUTH_MFA_SEED_KEYS=<output of: node generate-secret.mjs --mfa>

# The name shown beside the code in an authenticator app. A brand string, not a secret.
AUTH_TOTP_ISSUER=TManage

# ── First owner (one time only, on a fresh install) ──────────────────────────────
# There is no public sign-up. To create the first organisation and its owner, add this line
# with a fresh secret of its own (run `node generate-secret.mjs` once more; at least 32
# characters, different from every secret above), restart the app, then open
# https://tmanage.peetrix.com/setup and enter the same value there. /setup only works while
# no organisation exists yet. As soon as the owner is created, DELETE this variable in hPanel
# and restart. When it is not set, the setup page does not exist at all.
# SETUP_TOKEN=<output of: node generate-secret.mjs (a new one, used once, then deleted)>

# Public sign-up at /sign-up. On when this line is absent; set it to off to close sign-up
# (then rebuild, so the website's buttons go back to Sign in).
# PUBLIC_SIGNUP=on

# Platform admin at /platform (only for these verified emails; leave out to switch it off).
# Once the sign-up switch on /platform/settings has been used, it overrides PUBLIC_SIGNUP.
# PLATFORM_ADMIN_EMAILS=you@example.com

# "Continue with Google". Both from Google Cloud Console > Credentials > your OAuth web client;
# add https://tmanage.peetrix.com/v1/auth/google/callback to its Authorised redirect URIs.
# GOOGLE_CLIENT_ID=<the client id>
# GOOGLE_CLIENT_SECRET=<the client secret>

# ── Email (needed for invitations, notifications, password receipts) ────────────
# Use the mailbox Hostinger gives you for this domain (hPanel → Emails). Submission is usually
# port 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true.
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=no-reply@peetrix.com
EMAIL_FROM_NAME=TManage
SMTP_HOST=<your Hostinger mail host, look for "SMTP host">
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=<the full mailbox address>
SMTP_PASSWORD=<the mailbox password>

# ── File storage ───────────────────────────────────────────────────────────────
# Recommended on Hostinger shared hosting: keep uploaded files on the server's own disk, in a
# private folder OUTSIDE public_html. Create the folder first in hPanel -> File Manager, one level
# ABOVE public_html (in your home folder). The app refuses to start if this path is relative or
# sits inside public_html or any other web folder, so files can never be opened by a direct link.
# Files are only downloadable through the signed-in app, with the same permission checks as
# everything else. The folder must be part of your backups (see DEPLOY-HOSTINGER.md).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=<absolute path OUTSIDE public_html, e.g. /home/<your-user>/tmanage-storage>
# A fresh secret of its own: run `node generate-secret.mjs` once more. It must differ from
# SESSION_SECRET and CSRF_SECRET.
STORAGE_LOCAL_SIGNING_SECRET=<output of: node generate-secret.mjs (a new one, not reused)>
# Not used by the local disk option, but the app still requires a value. Leave it as is.
STORAGE_BUCKET=unused-local
# Optional. How long an upload link stays valid, in seconds (default 900 = 15 minutes; max 3600).
# STORAGE_UPLOAD_URL_TTL_SECONDS=900
# Optional. Storage quota per organization, in bytes (default 524288000 = 500 MB). Files also
# count against your hosting plan's disk space.
# STORAGE_ORG_BYTES_LIMIT_BYTES=524288000

# Alternative, for later: an S3-compatible bucket (AWS S3, Cloudflare R2, ...). To switch, remove
# the local block above and fill these with real credentials from the provider. Files already on
# the server's disk are not moved automatically; moving them is a separate later step.
# STORAGE_DRIVER=s3
# STORAGE_BUCKET=<bucket name, e.g. tmanage-files>
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=<https://... the provider's S3 endpoint, if it is not AWS>
# STORAGE_ACCESS_KEY_ID=<access key>
# STORAGE_SECRET_ACCESS_KEY=<secret key>

# ── Malware scanning ────────────────────────────────────────────────────────────
# There is no virus scanner on shared hosting. "none" is the honest production value: uploaded
# files are recorded as unscanned and are not promoted to "ready".
MALWARE_SCAN_DRIVER=none

# ── Background work ──────────────────────────────────────────────────────────────
# Run the outbox relay inside the web process on a timer. This is how mail/notifications get
# delivered when the plan cannot keep a second process alive. LIMIT: when the app sleeps (no
# traffic), delivery pauses until the next request. Set to 1 to enable; remove to disable.
WORKER_INPROCESS=1

# ── Leave these at their defaults ────────────────────────────────────────────────
# The app uses a Redis URL in its schema for historical reasons but never dials it on this
# plan; these two must not be the word "memory" in production, so leave them as "redis".
QUEUE_DRIVER=redis
CACHE_DRIVER=redis
