{
  "name": "@tmanage/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol server for TManage — lets Claude Desktop/Code, ChatGPT and any MCP-capable assistant work in a TManage workspace over the HTTP API, authenticated with a personal access token.",
  "bin": {
    "tmanage-mcp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "prepack": "tsc -b",
    "pack:bridge": "pnpm pack --pack-destination ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
