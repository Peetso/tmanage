{
  "name": "@tmanage/web",
  "version": "0.1.0",
  "private": true,
  "description": "The TManage team application and client portal — Next.js App Router (WEB-001).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/localize-prerendered-html.mjs",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "storybook": "storybook dev -p 6008 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "vr": "pnpm build:storybook && node vr/run.mjs",
    "vr:update": "pnpm build:storybook && node vr/run.mjs --update-snapshots"
  },
  "dependencies": {
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@tanstack/react-query": "^5.102.4",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-mention": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-task-item": "3.32.2",
    "@tiptap/extension-task-list": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/suggestion": "3.32.2",
    "@tmanage/domain": "workspace:*",
    "@tmanage/ui": "workspace:*",
    "docx-preview": "0.4.1",
    "emoji-mart": "5.6.0",
    "jszip": "3.10.2",
    "next": "16.4.2",
    "pdfjs-dist": "5.4.296",
    "perfect-freehand": "1.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wavesurfer.js": "7.12.12"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@tmanage/config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.5.10",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
