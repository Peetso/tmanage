{
  "name": "@tmanage/web",
  "version": "0.1.0",
  "private": true,
  "description": "The TManage team application and client portal — Next.js App Router (WEB-001).",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/localize-prerendered-html.mjs",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "storybook": "storybook dev -p 6008 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "vr": "pnpm build:storybook && node vr/run.mjs",
    "vr:update": "pnpm build:storybook && node vr/run.mjs --update-snapshots"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.4",
    "@tmanage/domain": "workspace:*",
    "@tmanage/ui": "workspace:*",
    "next": "~16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@tmanage/config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.5.10",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
