{
  "name": "@tmanage/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./hostinger": {
      "types": "./dist/hostinger-exports.d.ts",
      "default": "./dist/hostinger-exports.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project database",
    "sweep:once": "node dist/sweep.js --once",
    "verify:once": "node dist/verify.js --once",
    "preview:once": "node dist/preview.js --once",
    "reconcile:once": "node dist/reconcile.js --once",
    "cleanup:once": "node dist/cleanup.js --once",
    "db:migrate": "tsx src/common/database/cli.ts migrate",
    "db:status": "tsx src/common/database/cli.ts status",
    "db:grants": "tsx src/common/database/cli.ts grants",
    "db:reset": "tsx src/common/database/cli.ts reset",
    "mfa:encrypt-seeds": "tsx src/common/database/cli.ts mfa-seeds encrypt",
    "mfa:seeds-status": "tsx src/common/database/cli.ts mfa-seeds status"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@node-rs/argon2": "^2.1.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tmanage/config": "workspace:*",
    "@tmanage/domain": "workspace:*",
    "@tmanage/mail": "workspace:*",
    "@tmanage/mcp-server": "workspace:*",
    "@tmanage/storage": "workspace:*",
    "ag-psd": "31.0.3",
    "bidi-js": "1.1.0",
    "docx": "9.15.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.2",
    "image-size": "^2.0.4",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "libheif-js": "^1.23.5",
    "mediainfo.js": "0.3.8",
    "mmdb-lib": "3.0.3",
    "mysql2": "^3.15.1",
    "omggif": "^1.0.10",
    "pdf-lib": "1.17.1",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "utif": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@tmanage/test-kit": "workspace:*",
    "@tmanage/worker": "workspace:*",
    "@types/ws": "^8.5.12",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "ws": "^8.18.0"
  }
}
