{
  // Typecheck covers the unit tests too: a guard test that references a policy the
  // module no longer exposes should fail here, not at `vitest run`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "vitest.smoke.config.ts"],
  // The smoke harness is CommonJS-compiled by its own tsconfig (test:smoke), and the smoke
  // spec uses `import.meta` (valid under Vitest's ESM transform, not this CJS project), so
  // the smoke directory is typechecked there rather than here.
  "exclude": ["dist", "node_modules", "test/smoke"]
}
