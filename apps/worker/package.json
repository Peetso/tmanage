{
  "name": "@tmanage/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "relay:once": "node dist/main.js --once"
  },
  "dependencies": {
    "@tmanage/config": "workspace:*",
    "@tmanage/domain": "workspace:*",
    "mysql2": "^3.15.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/ws": "^8.5.12"
  }
}
