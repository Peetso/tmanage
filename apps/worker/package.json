{
  "name": "@tmanage/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "relay:once": "node dist/main.js --once",
    "relay:status": "node dist/main.js --status",
    "relay:unpark": "node dist/main.js --unpark",
    "sweep:invitations": "node dist/main.js --sweep-invitations",
    "sweep:deferred-requests": "node dist/main.js --sweep-deferred-requests",
    "sweep:due-soon": "node dist/main.js --sweep-due-soon",
    "keys:rotate": "node dist/main.js --rotate-keys"
  },
  "dependencies": {
    "@tmanage/config": "workspace:*",
    "@tmanage/domain": "workspace:*",
    "@tmanage/mail": "workspace:*",
    "mysql2": "^3.15.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tmanage/test-kit": "workspace:*",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "@types/ws": "^8.5.12"
  }
}
