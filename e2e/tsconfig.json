{
  // This project typechecks two things: the Playwright journeys, and `contracts/` — the
  // API↔web response-shape pairing that `pnpm contracts:check` guards (D10).
  //
  // The pairing has to import type-only from `apps/api/src/**` and `apps/web/src/lib/api/**`
  // at once, and `e2e` is the one workspace outside every `no-restricted-imports` boundary
  // glob in `eslint.config.js` (those target `apps/web/**`, `packages/ui/**` and
  // `packages/domain/**`), so it is the legal place to join the two sides.
  //
  // Four options diverge from `tsconfig.base.json` for that reason alone:
  //
  //   - `rootDir: ".."` — the imported sources live outside `e2e/`. Without this every one
  //     of them is TS6059 "not under rootDir".
  //   - `moduleResolution: "bundler"` (with `module: "preserve"`) — `apps/api` writes `.js`
  //     specifiers (NodeNext) and `apps/web` writes extensionless ones (Next's bundler
  //     resolution). Only `bundler` resolves both, and the journeys' own `./stack.js`
  //     imports resolve under it unchanged.
  //   - `experimentalDecorators: true` — matches `apps/api/tsconfig.json`; the Nest service
  //     graph pulled in by the pairing is written against legacy decorators.
  //   - `lib` gains DOM — `apps/web/src/lib/api/*.ts` are browser sources (`fetch`,
  //     `Response`, `AbortSignal`).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "rootDir": "..",
    "module": "preserve",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test-results"]
}
