  "layout": {
    "orbitalRail": "88px",
    "orbitalRailCompact": "72px",
    "contextRail": "248px",
    "contextRailMin": "200px",
    "contextLens": "360px",
    "readingWidth": "680px",
    "docWidth": "820px"
  },
  "motion": {
    "micro": "140ms",
    "selection": "180ms",
    "panel": "240ms",
    "track": "300ms",
    "easing": "cubic-bezier(0.2,0.6,0.2,1)",
    "reducedMotion": "opacity 120ms only"
  },
  "density": {
    "editorial": {
      "row": "56px",
      "control": "48px",
      "radius": "32px"
    },
    "balanced": {
      "row": "42px",
      "control": "40px",
      "radius": "24px"
    },
    "operational": {
      "row": "38px",
      "control": "36px",
      "radius": "18px"
