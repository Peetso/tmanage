      "paper": {
        "0": "#FFFFFF",
        "50": "#F7F7F3",
        "150": "#E9E9E5",
        "250": "#D5D6D1",
        "350": "#E4E4DF"
      },
      "line": {
        "300": "#C5C7C0",
        "700": "#2C2E29"
      },
      "lime": {
        "100": "#E9FFD0",
        "500": "#B7FF57",
        "600": "#9CEA3F"
      },
      "client": {
        "500": "#7755C7"
      },
      "success": {
        "600": "#1D8A63"
