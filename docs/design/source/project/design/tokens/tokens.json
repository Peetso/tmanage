    "scale": {
      "display.xl": {
        "size": 72,
        "line": 76,
        "weight": 500,
        "track": "-0.03em"
      },
      "display.lg": {
        "size": 56,
        "line": 62,
        "weight": 500,
        "track": "-0.025em"
      },
      "display.metric": {
        "size": 64,
        "line": 64,
        "weight": 400,
        "track": "-0.02em",
        "numeric": "tabular"
      },
      "heading.page": {
        "size": 36,
        "line": 42,
        "weight": 600
      },
      "heading.section": {
        "size": 24,
        "line": 31,
        "weight": 600
      },
      "heading.card": {
        "size": 20,
        "line": 27,
        "weight": 600
      },
      "body.lg": {
        "size": 17,
        "line": 25,
        "weight": 400
      },
      "body.md": {
        "size": 15,
        "line": 22,
        "weight": 400
      },
      "ui.md": {
        "size": 14,
        "line": 20,
        "weight": 500
      },
      "ui.sm": {
        "size": 13,
        "line": 18,
        "weight": 500
      },
      "caption": {
        "size": 12,
        "line": 17,
        "weight": 500
      }
    },
    "arabic": {
      "sizeFactor": 0.9,
      "lineFactor": 1.34,
      "tracking": "0"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
