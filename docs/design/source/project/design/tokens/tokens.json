  "radius": {
    "micro": "10px",
    "control": "14px",
    "compactSurface": "18px",
    "card": "24px",
    "sheet": "28px",
    "feature": "32px",
    "capsule": "999px"
  },
  "orb": {
    "compact": "32px",
    "default": "40px",
    "comfortable": "44px",
    "navigation": "48px",
    "feature": "56px",
    "hero": "64px"
  },
  "border": {
    "quiet": "1px",
    "structural": "1.5px",
    "expressive": "2px"
  },
  "focus": {
    "ring": "2px solid #090A09",
    "halo": "0 0 0 3px #B7FF57",
    "darkRing": "2px solid #F5F6F0",
    "darkHalo": "0 0 0 3px #A9ED55"
