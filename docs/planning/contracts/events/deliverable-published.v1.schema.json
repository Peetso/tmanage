{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tmanage.example/events/deliverable-published.v1.schema.json",
  "title": "deliverable.published.v1 payload",
  "type": "object",
  "required": ["deliverableId", "deliverableVersionId", "contentHash", "clientOrganizationId", "approvalId", "reviewerUserIds", "policyFingerprint"],
  "properties": {
    "deliverableId": { "type": "string", "format": "uuid" },
    "deliverableVersionId": { "type": "string", "format": "uuid" },
    "contentHash": { "type": "string", "minLength": 32, "maxLength": 128 },
    "clientOrganizationId": { "type": "string", "format": "uuid" },
    "approvalId": { "type": "string", "format": "uuid" },
    "reviewerUserIds": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
    "policyFingerprint": { "type": "string", "minLength": 16, "maxLength": 256 },
    "dueAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
