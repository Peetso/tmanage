      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/arch/part-docs-gate.mjs\" gate", "timeout": 10 } ] },
      { "matcher": "Bash|PowerShell", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/arch/part-docs-gate.mjs\" gate", "timeout": 10 } ] }
