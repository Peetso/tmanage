# TManage — example environment.
#
# Copy to `.env` for local development:  cp .env.example .env
#
# Every value here is a SAFE LOCAL PLACEHOLDER. No real secret, key, token, hostname, or
# customer identifier belongs in this file or in any committed file.
# Real values come from the deployment secret store (docs/runbooks/deploy.md).
#
# `packages/config` validates this schema at process start. A missing or malformed
# variable fails the boot deliberately rather than defaulting to something unsafe.

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# The password-less development sign-in (POST /v1/dev/sessions). Off unless this says true, and
# refused when NODE_ENV=production.
ALLOW_DEV_SIGN_IN=true
LOG_LEVEL=debug

# 50-BOOTSTRAP-DEPLOYMENT §9. Changes capacity and feature availability ONLY — never
# authorization or data-integrity rules. `bootstrap` matches the owner's funded
# environment (one small Hostinger Cloud plan) and is the default.
DEPLOYMENT_PROFILE=bootstrap

# ── API ────────────────────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated exact origins. Wildcards are rejected: the API is called with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# D09. Comma-separated addresses and CIDR ranges of the reverse proxies that actually front
# this API, and nothing else — the only peers whose X-Forwarded-* headers are believed.
# Blank or unset is the safe default and the right value here: trust nobody, read the socket
# peer. A name, a stray comma, a /33 or a /0 fails the boot by name rather than quietly
# becoming "trust nobody" or "trust everybody". Example: 203.0.113.7,10.0.0.0/8,2001:db8::/32
# Where a proxy IS named, the address believed is the RIGHT-MOST X-Forwarded-For entry that no
# trusted peer wrote, taken verbatim. A proxy that APPENDS its own observation is therefore the
# SAFE shape (its entry ends the walk; the client's sit to its left, unreached). Three shapes
# hand the address back to the client: a proxy that forwards their header untouched, one that
# PREPENDS its observation, and a range here wide enough to contain real clients. With more than
# one hop in front, name them all or every client collapses into the nearest unnamed hop. The
# measured table and the per-server directives are in docs/runbooks/deploy.md.
TRUSTED_PROXY_ADDRESSES=

# ── Web application (apps/web) — public, compiled into the browser bundle ─────
# Read by `next build`, not by the API; validated in apps/web/next.config.ts. Neither value is
# a secret: the origin is in every request and the cookie NAME is in every Set-Cookie.
#
# Where the browser reaches the API. Development default: http://localhost:3001 (the API's
# `pnpm dev` port). A production build REFUSES to proceed when this is absent, plain-http, or
# a loopback address (review finding D19) — the two supported production shapes are:
#   same-origin                 the browser talks only to the web origin and the web server
#                               forwards /v1/* to API_PROXY_TARGET (the supported topology on
#                               50-BOOTSTRAP §3's two Node applications: cookies are then set
#                               on one host, the CSRF cookie is readable, refresh works after
#                               a reload — review finding D03);
#   https://api.example.com     the browser dials the API directly. Only correct when the API
#                               shares the web page's HOST NAME (a port apart, as in the e2e
#                               stack); on a sibling subdomain its cookies are invisible to
#                               the page's script.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Server-side only (no NEXT_PUBLIC_): the API's origin as the web server reaches it. Required
# exactly when NEXT_PUBLIC_API_BASE_URL=same-origin, refused otherwise. Plain http is accepted
# in production only for a loopback address (the API on this machine); an API on another host
# must be reached over https. In that topology set API_PUBLIC_URL above to the WEB origin (it
# decides the cookies' Secure flag) and keep CORS_ALLOWED_ORIGINS at the web origin.
# API_PROXY_TARGET=http://127.0.0.1:4000
# The session cookie name the browser derives its CSRF cookie name from (`<name>_csrf`). Must
# equal SESSION_COOKIE_NAME below. Both default to tmanage_session (review finding D02: the
# two defaults used to disagree), so leave both unset or set both.
# NEXT_PUBLIC_SESSION_COOKIE_NAME=tmanage_session

# ── Database — MariaDB 11.8 ────────────────────────────────────────────────────
# MariaDB 11.8 is the engine everywhere: compose.yaml, the database suites (a private MariaDB
# 11.8 server per test file, or compose's via TMANAGE_TEST_DATABASE_URL), and production
# (Hostinger). The driver is `mysql2`, and `mysql://` is simply that driver's URL scheme; it
# does not mean a MySQL server.
# Two distinct users (25-AUTH-AND-TENANT-ISOLATION §5, ADR-0001 layer 2).
# RUNTIME user: DML privileges only. Cannot alter schema, grant, create users, or reach
# another database. MariaDB has no row-level security, so this credential boundary is one of
# the few controls that still holds if application code is bypassed.
DATABASE_URL=mysql://tmanage_app:local_dev_only_app@localhost:3306/tmanage
# MIGRATION user: owns the schema. Used only by the migrator, never by a running app.
DATABASE_MIGRATION_URL=mysql://tmanage_migrator:local_dev_only_migrator@localhost:3306/tmanage
# WORKER user: the relay's own (scripts/db/users.sql). Marks outbox rows, appends audit
# rows, deletes nothing. Required in production; the worker falls back to DATABASE_URL
# elsewhere and says so at boot.
WORKER_DATABASE_URL=mysql://tmanage_worker:local_dev_only_worker@localhost:3306/tmanage
# Hostinger's smallest plan has a tight connection allowance (50-BOOTSTRAP §4).
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
# ADR-0001 layer 3 — the row-level-security replacement. `enforce` throws when a statement
# touches a tenant-owned table without an organization_id predicate. Only ever set
# `observe` for a documented incident.
TENANT_GUARD_MODE=enforce

# ── Redis-compatible cache / queue / rate limit / presence ─────────────────────
# Local: Valkey via compose. Bootstrap deploy: Upstash Redis Free.
# 50-BOOTSTRAP §4: Redis is ephemeral only — MariaDB and the outbox remain durable truth.
REDIS_URL=redis://localhost:6379
# `memory` is the no-container substitute (ADR-0002). Never in staging/production.
QUEUE_DRIVER=redis
CACHE_DRIVER=redis

# ── Object storage (S3-compatible, private) ────────────────────────────────────
# Local: MinIO via compose. Bootstrap deploy: Cloudflare R2 Standard free allowance.
# Customer files never live on the application disk (03-TECHNICAL-ARCHITECTURE §11).
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
# Buckets are separated by trust state: quarantine / ready / derived.
STORAGE_BUCKET=tmanage-local-ready
STORAGE_ACCESS_KEY_ID=local_dev_only_minio
STORAGE_SECRET_ACCESS_KEY=local_dev_only_minio_secret
STORAGE_FORCE_PATH_STYLE=true
# 25-AUTH-AND-TENANT-ISOLATION §9 caps authorized download URLs at five minutes.
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
STORAGE_UPLOAD_URL_TTL_SECONDS=900
# Local filesystem root when STORAGE_DRIVER=filesystem. That driver is for development and
# the e2e stack only: it is refused when NODE_ENV=production, where STORAGE_DRIVER=s3 and
# the API's own part-upload route (FILE-001b) is bound to nothing and answers 404.
# Production on a single host (Hostinger shared hosting, ADR-0002 amendment 2026-10-17) uses
# STORAGE_DRIVER=local instead: the same on-disk store, under the production guards below.
# Relative paths resolve against the process's working directory. On Windows keep the root
# SHORT, ideally absolute: an object key is about 160 characters below it, and a root deep
# under a user profile pushes the final rename past MAX_PATH (260), where it fails as ENOENT.
STORAGE_FILESYSTEM_ROOT=.local/storage
# Root when STORAGE_DRIVER=local (production, single host). Must be ABSOLUTE and outside any
# web root: never inside public_html, public, www or htdocs. The API refuses to start
# otherwise. STORAGE_LOCAL_SIGNING_SECRET below signs this driver's upload links too.
# STORAGE_LOCAL_ROOT=/absolute/path/outside/the/web/root
# FILE-001b. Signs the part-upload URLs the API serves itself when STORAGE_DRIVER=filesystem.
# Required by that driver; its own value, never SESSION_SECRET or CSRF_SECRET (refused in
# production when equal). Generate as the session secrets below are generated.
STORAGE_LOCAL_SIGNING_SECRET=local_dev_only_storage_signing_secret_change_me_00000

# ── Sessions and cryptography ──────────────────────────────────────────────────
# Generate real values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# These placeholders are rejected when NODE_ENV=production.
SESSION_COOKIE_NAME=tmanage_session
SESSION_SECRET=local_dev_only_session_secret_change_me_0000000000
SESSION_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600
CSRF_SECRET=local_dev_only_csrf_secret_change_me_0000000000
# D07 — the keys TOTP seeds are encrypted with, so a database dump holds ciphertext rather
# than usable second factors. Entries are <version>:<base64url 32-byte key>, separated by ";".
# The HIGHEST version is active: everything new is encrypted under it, and the older entries
# stay so rows written before a rotation still open. To rotate, append a higher version,
# restart, run `pnpm --filter @tmanage/api mfa:encrypt-seeds`, then drop the old entry once
# `mfa:seeds-status` reports nothing left under it. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# This placeholder is a working key (local development needs one) and is rejected when
# NODE_ENV=production. Losing every key means losing every enrolled factor: back them up
# where the database backups are not.
AUTH_MFA_SEED_KEYS=1:local_dev_only_mfa_seed_key_change_me_00000

# 56-02 — FieldCipher keyring for every recoverable secret (connector tokens, webhook secrets,
# SCIM tokens, push keys). `<id>:<key>` entries separated by ";", the highest id is the active
# key. Generate a key with `openssl rand -base64 32`. Empty = FieldCipher disabled: features that
# need it refuse rather than store plaintext. Rotate: add a higher id, deploy, queue a rotation,
# wait for rows_done + rows_skipped + rows_failed = rows_total, remove the old id next deploy.
# Keep the offline copy with Peter (deploy.md "Where the key lives").
FIELD_CIPHER_KEYS=

# ID-002 — the lockout window, counted from authentication_events because there is no Redis.
# Per user, not per source: it stops stuffing against one account, not one attempt each
# against a thousand.
AUTH_MAX_FAILURES_IN_WINDOW=5
AUTH_FAILURE_WINDOW_SECONDS=900
# Shown beside the code in an authenticator app. A brand string, not a secret.
AUTH_TOTP_ISSUER=TManage
# Argon2id (04-SECURITY-PRIVACY §3). Tuned per host before production.
PASSWORD_ARGON2_MEMORY_KIB=19456
PASSWORD_ARGON2_TIME_COST=2
PASSWORD_ARGON2_PARALLELISM=1

# First-owner setup. There is no public sign-up, so a fresh production install creates its
# first organisation and owner through /setup. Optional and one-time: when this is unset (the
# default, and the right value here) the setup routes do not exist and answer 404. Set it only
# on a fresh install, at least 32 characters, its own value (never SESSION_SECRET or
# CSRF_SECRET); /setup also stays closed once any organisation exists. Delete it after the
# first owner is created. Generate with `node deploy/hostinger/generate-secret.mjs`.
# SETUP_TOKEN=

# Public self-service sign-up at /sign-up (name, email, password, workspace name -> a new
# organisation owned by that person). ON when unset. `off` removes the API routes (404) and
# turns the website's "Start free" links back into Sign in (the web reads it at build time).
# PUBLIC_SIGNUP=on

# Public beta: beta_free (the default) makes everything free - every organization gets the top
# plan's limits and features, and plan changes / purchases answer 409 billing_disabled_beta.
# Set it to paid to switch the plan catalog and plan changes back on.
BILLING_MODE=beta_free

# Platform admin at /platform: the TManage operator's full-control console (organizations, people,
# content through a recorded Support session, activity, settings). PLATFORM_ADMIN_EMAILS are the
# bootstrap super admins; more admins are managed in Platform admin → Team. Comma list of verified
# emails, compared ignoring case. An address listed here is always a super admin and cannot be
# demoted or disabled from the UI, so the operator can never be locked out. Unset and no active
# admin in Platform admin → Team = the feature does not exist (404).
# PLATFORM_ADMIN_EMAILS=you@example.com

# Operator alerts: who is emailed (through the mail settings above) when the app answers a
# server error or a background job fails — at most once per 15 minutes per kind. Comma list.
# Unset = no alert mail. GET /healthz/deep is the check to give a free uptime monitor.
# ALERT_EMAILS=you@example.com

# 56-27 (ADR-0007). Schema-drift check: with drift, enforce (the production default when unset)
# answers 503 on every API route except /healthz/deep; report only logs. Kill switch only.
# SCHEMA_DRIFT_MODE=enforce

# 51-12. Optional: the free uptime monitor's public status page (https only). Returned as
# liveStatusUrl by GET /v1/public/site/status/summary for the /status page's "Live status" link.
# STATUS_PAGE_URL=https://stats.uptimerobot.com/your-page

# "Continue with Google" on Sign in, Sign up and invitations (OpenID Connect: openid email
# profile only). Both set = the button shows; either unset = no button and the routes 404. The
# Google OAuth client must list <WEB_PUBLIC_URL>/v1/auth/google/callback as a redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# FIX4: one-click "Connect" for Figma (free Figma app at figma.com/developers/apps, scopes
# current_user:read file_content:read file_metadata:read). Both set = Integrations' Figma card
# connects in one click; unset = members paste a personal access token instead. The app must list
# <API_PUBLIC_URL>/v1/integrations/figma/callback as its callback URL.
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=

# ── Invitations and client access ──────────────────────────────────────────────
INVITATION_TTL_HOURS=168
CLIENT_MEMBERSHIP_DEFAULT_EXPIRY_DAYS=180

# ── Idempotency ────────────────────────────────────────────────────────────────
IDEMPOTENCY_RETENTION_HOURS=24

# ── Outbox relay (PLAT-004) ──────────────────────────────────────────────────────────
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_CAP_MS=900000

# Is the relay draining? A healthy idle worker and a dead one log the same thing — nothing —
# so the reading that separates them is how old the oldest undelivered event is, plus how
# long ago a batch last finished. `pnpm --filter @tmanage/worker relay:status` prints both as
# one JSON line and exits 1 when either is past its threshold; `relay:once` exits 1 when the
# backlog alone is. Point cron or an uptime check at those exit codes — that is the alarm.
OUTBOX_BACKLOG_MAX_AGE_SECONDS=900
OUTBOX_HEARTBEAT_MAX_AGE_SECONDS=900
# Where a completed batch records the time, for a later `relay:status` to read. It ships with a
# real path on purpose: it is the only reading that separates "drained and idle" from "dead with
# an empty queue", and shipped empty it was absent from the default deployment — a relay that
# died on Friday with a drained queue reported ok and exited 0 all weekend. Leave it empty only
# on a host with no writable path; that is a supported shape (the worker reads empty as "keep no
# heartbeat", not as a fault) and it narrows the readings to backlog age alone.
OUTBOX_HEARTBEAT_FILE=var/worker-heartbeat.json

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
# 56-05. The daily pepper for durable rate-limit keys (a secret, never logged). Unset or empty
# falls back to CSRF_SECRET.
# PUBLIC_LINK_PEPPER=
# D08. The sign-in abuse control: source+account, source, global — one shared window.
# PER_SOURCE is 30 charges per address per window across all four authentication routes
# (password, MFA, recovery, reauth) — a per-office ceiling wherever egress is shared, and the
# one to raise behind NAT. Fifteen complete MFA logins, not thirty: the password post and the
# completion post each spend one, and a password change spends a third on /v1/auth/reauth.
# GLOBAL is shared by everybody: whoever spends it refuses everybody
# until the window turns, which is why it is 3000 (~10/s) and not a number a small spray reaches.
# How much a per-address budget is worth depends on TRUSTED_PROXY_ADDRESSES above. Unset (the
# default) the address is the socket peer, so a host that writes X-Forwarded-For gains nothing.
# Where a proxy IS named, a MISCONFIGURED one still lets the client behind it pick the address,
# and both address-keyed budgets rotate with it — the three shapes to avoid, and the measured
# table behind them, are in docs/runbooks/deploy.md (an APPENDING proxy is the safe shape, not
# one of the three). Address abundance is
# separate and still open: one IPv6 /64 holds 2^64 real addresses
# (docs/implementation-status.md follow-up 6), so treat the address-keyed numbers as a cost
# bound on honest traffic and GLOBAL as the bound nobody rotates past.
# Security audit 2026-09-12 (C-1): MAX_REQUESTS is the source+account budget and must stay
# STRICTLY BELOW AUTH_MAX_FAILURES_IN_WINDOW (5). The API refuses to boot otherwise, by design
# — at 10 one address could spend the fifth wrong password that puts any known account into
# the 900-second lockout, renewably, and the account holder could not clear it, because
# re-authentication reads the same counter and is the only gate to changing a password.
# Raising this means raising AUTH_MAX_FAILURES_IN_WINDOW with it, not instead of it.
RATE_LIMIT_AUTH_MAX_REQUESTS=4
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_MAX_PER_SOURCE=30
RATE_LIMIT_AUTH_MAX_GLOBAL=3000

# ── Observability ──────────────────────────────────────────────────────────────
# OBS-001. Trace export is off by default; spans stay in-process and no telemetry leaves the
# machine (50-BOOTSTRAP §2 requires no paid observability subscription). Turn it on only with an
# endpoint: OTEL_ENABLED=true with OTEL_EXPORTER_URL empty is a loud boot failure, never a silent
# no-op. The OTel-standard OTEL_* names are intentionally absent until the SDK follow-up lands.
OTEL_ENABLED=false
# OTEL_EXPORTER_URL=https://otel-collector.example:4318   # required when OTEL_ENABLED=true

# ── Email ──────────────────────────────────────────────────────────────────────
# `console` writes to the log and sends nothing. A real provider requires explicit owner
# authorization and a configured domain; do not switch this without both.
EMAIL_DRIVER=console
EMAIL_FROM_ADDRESS=no-reply@tmanage.example
EMAIL_FROM_NAME=TManage
# The smtp driver needs a host; the rest have working defaults. Port 587 is submission
# with STARTTLS (Hostinger's shape); 465 with SMTP_SECURE=true is implicit TLS. Leave
# the credentials unset only for a relay that accepts unauthenticated local submission.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=no-reply@tmanage.example
# SMTP_PASSWORD=change_me

# ── AI copilot (Module 16 — Search, command & AI) ──────────────────────────────
# The copilot ships OFF: it is also gated per-org by the `copilot` feature flag (default off), so
# these variables do nothing until an org turns that flag on. They pick which PROVIDER answers once
# it is on. `stub` is the default and the only keyless, offline, no-network option — a deterministic,
# source-cited canned answer; leave it here. `anthropic` and `openai` are the paid-model path, CODED
# for the future but inert without a key: coded so the swap is a config change, not a build.
#
# A real provider ALSO needs COPILOT_API_KEY and COPILOT_MODEL. If either is missing, the name is
# unknown, or a call fails, the copilot falls back to the offline stub (logged once) and never
# crashes. Only the asking member's question and their already-resolved scope leave the process —
# never a record or a project id. No key belongs in this committed file; real values come from the
# deployment secret store (docs/runbooks/deploy.md).
COPILOT_PROVIDER=stub
# COPILOT_API_KEY=
# COPILOT_MODEL=

# ── Malware scanning ───────────────────────────────────────────────────────────
# `stub` marks uploads clean in development only and is refused when NODE_ENV=production.
# `none` is the bootstrap value (FILE-002 decision F3, 50-BOOTSTRAP §39): legal in
# production, and honest — every verified upload is recorded `unscanned` once and parks at
# `scanning`; nothing becomes `ready` or downloadable until a scanner is configured.
# `clamav` streams each object to a clamd (INSTREAM) at CLAMAV_HOST:CLAMAV_PORT; the clamd's
# StreamMaxLength must be at least UPLOAD_MAX_BYTES or a legal upload is refused as an error.
MALWARE_SCAN_DRIVER=stub
MALWARE_SCAN_TIMEOUT_MS=30000
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# 50-BOOTSTRAP §6 caps a single private-alpha upload at 100 MB.
UPLOAD_MAX_BYTES=104857600
# FILE-001b. One multipart part, 8 MiB. Only a test harness lowers it.
UPLOAD_PART_SIZE_BYTES=8388608
# Open (reserved) upload sessions one person may hold at once; the next is refused 429.
UPLOAD_MAX_OPEN_SESSIONS_PER_USER=20

# ── Backups (51-09; scripts/ops, run by the hPanel cron — never by the app) ──────
# BACKUP_DIR=/home/<user>/tmanage-backups
# Off-site copy, optional: encrypt to this age public key (age1…); the matching secret key file
# stays offline and is only given to restore.mjs (BACKUP_AGE_IDENTITY_FILE or --identity).
# BACKUP_AGE_RECIPIENT=
# BACKUP_AGE_IDENTITY_FILE=
# Google Drive upload of the encrypted copy (operator's own OAuth client; secrets, never logged).
# BACKUP_DRIVE_CLIENT_ID=
# BACKUP_DRIVE_CLIENT_SECRET=
# BACKUP_DRIVE_REFRESH_TOKEN=
# BACKUP_DRIVE_FOLDER_ID=

# ── Origin TLS (56-30; runbook docs/runbooks/origin-tls-526.md) ──────────────────
# Where /healthz/deep reads the origin's own certificate (checks.origin_tls), e.g. <origin ip>:443. Unset = not_configured.
# ORIGIN_TLS_PROBE_ADDRESS=
# scripts/ops/uptime-check.mjs: the origin to handshake with directly (bypassing Cloudflare). Unset = check skipped.
# UPTIME_ORIGIN_ADDRESS=
# SNI for that handshake; defaults to the host of UPTIME_URL.
# UPTIME_ORIGIN_SERVERNAME=

# ── Host capacity budget (56-32; docs/ops/hostinger-profile.md) ─────────────────
# The API samples memory / event-loop lag / sockets every 30 s and persists a reading every 5 min;
# a nightly reading (03:30 UTC) also counts inodes and disk under the app root. Plan ceilings live
# in platform_settings.host_profile_json (scripts/ops/host-profile.mjs --set '<json>').
# Off switch for the sampler (tests, one-off scripts): 1 = do not start it.
# TMANAGE_CAPACITY_SAMPLER_OFF=
# The directory the nightly inode walk and the disk reading start from (default: the process cwd).
# TMANAGE_APP_ROOT=
# Comma-separated paths left out of the inode walk (absolute, or relative to TMANAGE_APP_ROOT) —
# customer data, so PERF-H-03 measures code and assets alone.
# TMANAGE_INODE_EXCLUDE=storage,backups

# ── Realtime socket caps and keepalive (51-06; docs/runbooks/realtime-live-proof.md) ──
# Sockets this process holds at once; the next is closed 4429 `retry-after=30`.
# REALTIME_MAX_SOCKETS=500
# Sockets one member (organization + user) holds at once; the next is closed 4429 `retry-after=5`.
# REALTIME_MAX_SOCKETS_PER_MEMBER=5
# Server ping period; a socket that misses two pongs is terminated. Under LiteSpeed's idle timeout.
# REALTIME_PING_INTERVAL_MS=25000

# ── Browser security policy (56-01; docs/runbooks/csp-enforcement.md) ──
# Read by the web app's request proxy (apps/web/src/proxy.ts) on every page, so a change needs a
# restart, not a rebuild. A production build ENFORCES the nonce CSP (Trusted Types included) unless
# this is exactly `report` (or `report-only`), which sends it as Content-Security-Policy-Report-Only
# instead. `next dev` is report-only unless `enforce`. Unset = the default for the build.
# CSP_MODE=report

# ── Mail priority lanes (56-31; docs/runbooks/mail-lanes.md) ──
# `on` = every producer enqueues into mail_queue and the worker drainer alone sends, in lane order
# auth → transactional → digest → bulk against a shared hour window. Off (default) = direct send.
# MAIL_QUEUE=on
# The separate security@ mailbox for the `auth` lane (same SMTP_HOST). Peter's 10-minute step:
# hPanel → Emails → create security@tmanage.peetrix.com. Absent = one mailbox (noreply@); the lane
# order still protects sign-in codes.
# SMTP_SECURITY_USERNAME=
# SMTP_SECURITY_PASSWORD=
# EMAIL_SECURITY_FROM_ADDRESS=
# 56-17. security.txt `Contact:` (defaults to EMAIL_SECURITY_FROM_ADDRESS, then security@<host>).
# SECURITY_CONTACT_EMAIL=
